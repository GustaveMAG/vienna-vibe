# Copie ce fichier vers .env et renseigne les valeurs.
# .env est ignoré par git : aucun secret ne doit jamais être commité.

# --- Base de données ---
DATABASE_URL=postgresql://vienna:vienna@localhost:5432/vienna_vibe
POSTGRES_PASSWORD=vienna
POSTGRES_PORT=5432

# --- Spotify ---
# 1. Crée une application sur https://developer.spotify.com/dashboard
# 2. Ajoute http://127.0.0.1:8888/callback comme Redirect URI
# 3. Autorise le scope user-read-recently-played et récupère un refresh token
#    (voir la section « Obtenir un refresh token Spotify » du README)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# --- Airflow (interface locale) ---
AIRFLOW_PORT=8080
AIRFLOW_USER=admin
AIRFLOW_PASSWORD=change-me

# --- Réglages du pipeline ---
HTTP_TIMEOUT_S=20
HTTP_MAX_RETRIES=4
FRESHNESS_MAX_AGE_HOURS=3
